# Database (Free Neon / Supabase PostgreSQL 16)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.neon.tech/mocklab?sslmode=require"

# Redis (Render / Railway / Upstash TCP Redis 7)
REDIS_URL="redis://default:password@sample-redis.render.com:6379"

# Server Configuration
PORT=3001
NODE_ENV="development"

# Auth & Secrets (DO NOT hardcode secrets. Generate with: openssl rand -hex 32)
JWT_SECRET="" # Generate with: openssl rand -hex 32
SECRET_ENCRYPTION_KEY="" # Generate with: openssl rand -hex 32 (must be 64 hex characters)

# Web App Configuration
NEXT_PUBLIC_API_URL="http://localhost:3001" # Set to Render API URL in production (e.g. https://mocklab-api.onrender.com)
NEXT_PUBLIC_APP_URL="http://localhost:3000" # Frontend URL (e.g. https://mocklab-theta.vercel.app)
ALLOWED_ORIGINS="http://localhost:3000,https://mocklab-theta.vercel.app"
